BINARY EXPONENTIATON (O(LogN))
ll power(ll a, ll x){
    if(x==0) return 1;
    a%=MOD;
    ll num=1;
    while(x>0){
    	if(x&1)num=(num*a)%MOD;

    	a=(a*a)%MOD;
    	x>>=1;
    }
    return num;
}
===============================
ll power(ll a, ll x){
    if(x==0) return 1;
    if(x%2){
        ll res= power(a,(x-1)/2);
        return (res*res*a)%MOD;
    }
    else{
        ll res=power(a,x/2);
        return (res*res)%MOD;
    }
}
